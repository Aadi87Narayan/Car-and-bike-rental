# Server Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB Connection String)
# Local: mongodb://localhost:27017/drivex
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/drivex?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/drivex

# JWT Secrets (Use strong 64+ char random strings in production)
JWT_ACCESS_SECRET=drivex_access_secret_super_secure_key_2026_dev_mode_only
JWT_REFRESH_SECRET=drivex_refresh_secret_super_secure_key_2026_dev_mode_only

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Frontend URL for CORS & Cookie security
FRONTEND_URL=http://localhost:5173

# Admin Seed Credentials (Used only during 'npm run seed')
ADMIN_FIRST_NAME=DriveX
ADMIN_LAST_NAME=SuperAdmin
ADMIN_EMAIL=admin@drivex.in
ADMIN_PHONE=+919876543210
ADMIN_PASSWORD=AdminDriveX@2026

# Geospatial / Map Services (Geoapify or OpenStreetMap)
# Register at https://myprojects.geoapify.com/ for free API key
GEOAPIFY_API_KEY=

# Payment Gateway (Razorpay India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email / SMS Notifications (Optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="DriveX Rentals <support@drivex.in>"

# File Uploads Directory
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
